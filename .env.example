APP_NAME=cleanslice-platform
APP_VERSION=1.0.0
HTTP_PORT=8080

DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_DB=cleanslice_platform
POSTGRES_TEST_DB=cleanslice_platform_test
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=cleanslice-postgres

DB_REACTIVE_URL=postgresql://localhost:5432/cleanslice_platform
DB_JDBC_URL=jdbc:postgresql://localhost:5432/cleanslice_platform
DB_USERNAME_TEST=postgres
DB_PASSWORD_TEST=postgres
DB_REACTIVE_URL_TEST=postgresql://localhost:5432/cleanslice_platform_test
DB_JDBC_URL_TEST=jdbc:postgresql://localhost:5432/cleanslice_platform_test

DB_MIGRATE_AT_START=false
DB_MIGRATE_AT_START_TEST=true
DB_CLEAN_AT_START_TEST=true
DB_MIGRATION_VALIDATE_AT_START=true
DB_MIGRATION_VALIDATE_AT_START_TEST=false
DB_BASELINE_ON_MIGRATE=true
RUN_DB_INTEGRATION_TESTS=false
